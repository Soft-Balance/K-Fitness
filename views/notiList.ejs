<%-include('notilist-header.ejs')%>

<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div style="text-align: center;">

    <h1>공지</h1>

    <div class="noticelist-contactlist">
        <div class="accordion">

            <!-- <div style="text-align: right; margin-right: 0vw;">
                <button onclick="writing()">글 작성하기</button>
            </div> -->

            <div class="accordion-content">
                <header>
                    <span class="title"> 1. 어린이날 안내</span>
                    <i class="fa-solid fa-plus"></i>
                </header>

                <p class="description">
                    <br>
                    2023년 5월 5일 금요일<br>
                    오늘은 어린이 날입니다. 가족과 즐거운 하루 보내세요.
                    <br><br>
                    <img src="img\안내1.png"><br>
                </p>
            </div>

            <div class="accordion-content">
                <header>
                    <span class="title"> 2. 헬스장 도우미 안내</span>
                    <i class="fa-solid fa-plus"></i>
                </header>

                <p class="description">
                    <br>
                    2023년 6월 20일 화요일<br>
                    헬스장에서 도움을 주고 있는 도우미 회원님을 소개합니다. 
                    <br><br>
                    <video src="img\안내2.mp4" controls  ><br>
                </p>
            </div>
            
            <div class="accordion-content">
                <header>
                    <span class="title"> 3. 10월 정기 등록 안내</span>
                    <i class="fa-solid fa-plus"></i>
                </header>

                <p class="description">
                    <br>
                    2023년 10월 1일 일요일<br>
                    10월도 헬스장은 정상 영업합니다. <br><br>
                    <img src="img\안내3.png"><br>
                </p>
            </div>

            <div class="accordion-content">
                <header>
                    <span class="title"> 4. 11월 정기 등록 안내</span>
                    <i class="fa-solid fa-plus"></i>
                </header>

                <p class="description">
                    <br>
                    2023년 11월 1일 수요일<br>
                    11월도 헬스장은 정상 영업합니다. 
                    <br><br>
                    <img src="img\안내4.png"><br>
                </p>
            </div>

            <div class="accordion-content">
                <header>
                    <span class="title"> 5. 12월 할인 이벤트</span>
                    <i class="fa-solid fa-plus"></i>
                </header>

                <p class="description">
                    <br>
                    2023년 12월 1일 금요일<br>
                    올해의 마지막도 건강하게 보내자구요! 12월의 크리스마스를 맞이하여 할인 이벤트를 진행합니다. 쿠폰란에 X-mas를 입력하세요. 
                    <br><br>
                    <img src="img\안내5.png" style="width: 500px;"><br>
                </p>
            </div>

            <div class="accordion-content">
                <header>
                    <span class="title"> 6. 크리스마스 안내  </span>
                    <i class="fa-solid fa-plus"></i>
                </header>

                <p class="description">
                    <br>
                    2023년 12월 25일 월요일<br>
                    크리스 마스에 모든 사람에 축복을 기원합니다. 
                    <br><br>
                    <img src="img\안내6.png"><br>
                </p>
            </div>

        <div class="accordion-content">
            <header>
                <span class="title"> 7. 연말인사    </span>
                <i class="fa-solid fa-plus"></i>
            </header>

            <p class="description">
                <br>
                2023년 12월 30일 토요일<br>
                올 한해 목표한 내용은 잘 이루셨는지요? 2024년에도 건강한 모습으로 만나요. 
                <br><br>
                <img src="img\안내7.png"><br>
            </p>
        </div>
    </div>
</div>

<div style="text-align: center;">

    <h1>모집</h1>

    <div class="noticelist-contactlist">
        <div class="accordion">

            <!-- <div style="text-align: right; margin-right: 0vw;">
                <button onclick="writing()">글 작성하기</button>
            </div> -->

            <% lists.forEach(function(item){ %>

            <div class="accordion-content">

                <header>
                    <span class="title"> 모집 </span>
                    <i class="fa-solid fa-plus"></i>
                </header>

                <p class="description">
                    <a class="i">∙ <%=item.user1name%><br></a>
                    <%-item.memo.replaceAll("\n", "<br><br>")%>
                    <br><a class="delete" href="/notiDelete?idx=<%=item.idx%>" onclick="return confirm('정말 삭제할까요?')">[삭제]</a>
                </p>
            </div>
            
            <% }) %>

        </div>
</div>

<script src="contact_noti.js"></script>
