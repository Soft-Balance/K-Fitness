<%-include('header.ejs')%>

<link rel="stylesheet" href="/styles.css">

<div style="margin: 2% auto;">
    <h1 style="font-size: 60px;">위치</h1>
    <div id="map" style="width:100%;height:600px; display: inline-block; text-align: left; margin: 2% auto;"></div>
	<div id='popup' style="width:500px; height:600px; display:none; background-color:white; padding:20px; border-radius:14px; border:2px solid #eeeeee"></div>
</div>

    <script type="text/javascript">
        var mapOptions = {
            center: new naver.maps.LatLng(36.832279, 127.180331), // 초기 지도의 중심 좌표 설정
            zoom: 17 // 초기 지도의 줌 레벨 설정
        };

        var map = new naver.maps.Map('map', mapOptions); // 'map'은 HTML 요소의 id

        // 마커 추가 예제
        var markerOptions = {
            position: new naver.maps.LatLng(36.832279, 127.180331), // 마커의 위치 좌표 설정
            map: map // 마커가 표시될 지도 객체 설정
        };

        var marker = new naver.maps.Marker(markerOptions);

    </script>


<%-include('footer.ejs')%>